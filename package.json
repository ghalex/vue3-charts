{
  "name": "vue3-charts",
  "version": "1.1.34",
  "description": "SVG charting library for Vue 3 built on d3",
  "main": "dist/vue3-charts.js",
  "module": "dist/vue3-charts.esm.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/vue3-charts.esm.js",
      "require": "./dist/vue3-charts.js"
    },
    "./package.json": "./package.json"
  },
  "sideEffects": false,
  "files": [
    "dist"
  ],
  "scripts": {
    "serve": "vue-cli-service serve dev/serve.ts",
    "build": "rollup -c",
    "lib": "vue-cli-service build --target lib --name vue3-charts ./src/index.ts",
    "lint": "vue-cli-service lint",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "npm run lint && npm run format:check && npm run typecheck && npm run build"
  },
  "devDependencies": {
    "@babel/core": "^7.20.2",
    "@babel/preset-env": "^7.20.2",
    "@babel/preset-typescript": "^7.18.6",
    "@rollup/plugin-alias": "^5.1.1",
    "@rollup/plugin-babel": "^6.1.0",
    "@rollup/plugin-commonjs": "^28.0.9",
    "@rollup/plugin-node-resolve": "^16.0.3",
    "@types/d3-array": "^3.2.2",
    "@types/d3-axis": "^3.0.6",
    "@types/d3-format": "^3.0.4",
    "@types/d3-hierarchy": "^3.1.7",
    "@types/d3-interpolate": "^3.0.4",
    "@types/d3-scale": "^4.0.9",
    "@types/d3-selection": "^3.0.12",
    "@types/d3-shape": "^3.2.0",
    "@types/node": "^26.6.5",
    "@types/ramda": "^0.30.2",
    "@typescript-eslint/eslint-plugin": "^8.71.2",
    "@typescript-eslint/parser": "^8.71.2",
    "@vue/babel-preset-app": "^5.0.8",
    "@vue/cli-plugin-babel": "^5.0.8",
    "@vue/cli-plugin-eslint": "^5.0.8",
    "@vue/cli-plugin-typescript": "^5.0.8",
    "@vue/cli-service": "^5.0.8",
    "@vue/compiler-sfc": "^3.5.44",
    "core-js": "^3.26.1",
    "cross-env": "^7.0.3",
    "eslint": "^8.28.0",
    "eslint-config-prettier": "^9.1.2",
    "eslint-config-standard": "^17.0.0",
    "eslint-plugin-import": "^2.26.0",
    "eslint-plugin-node": "^11.1.0",
    "eslint-plugin-promise": "^6.1.1",
    "eslint-plugin-vue": "^9.7.0",
    "minimist": "^1.2.7",
    "postcss": "^8.4.19",
    "prettier": "^3.9.10",
    "rollup": "^2.61.1",
    "rollup-plugin-peer-deps-external": "^2.2.4",
    "rollup-plugin-postcss": "^4.0.2",
    "rollup-plugin-typescript2": "^0.36.0",
    "rollup-plugin-vue": "^6.0.0",
    "tsc-alias": "^1.7.1",
    "typescript": "^5.9.3",
    "vue": "^3.5.44",
    "vue-router": "^4.1.6"
  },
  "engines": {
    "node": ">=18"
  },
  "peerDependencies": {
    "vue": ">=3.0.0"
  },
  "dependencies": {
    "d3-array": "^3.2.0",
    "d3-axis": "^3.0.0",
    "d3-format": "^3.1.0",
    "d3-hierarchy": "^3.1.2",
    "d3-interpolate": "^3.0.1",
    "d3-scale": "^4.0.2",
    "d3-selection": "^3.0.0",
    "d3-shape": "^3.1.0",
    "ramda": "^0.30.1"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ghalex/vue3-charts.git"
  },
  "homepage": "https://vue3charts.org/",
  "keywords": [
    "vue",
    "vue3",
    "charts",
    "svg",
    "d3"
  ],
  "license": "MIT"
}
